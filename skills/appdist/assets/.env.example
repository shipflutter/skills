# ShipFlutter Build Environment (example)
# Copy to .env.prod and fill in your values:
#   cp .env.example .env.prod

# ── App Store Connect API credentials ────────────────────────────────────────
APPLE_API_KEY_ID="YOUR_API_KEY_ID"
ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
APPLE_API_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
YOUR_PRIVATE_KEY_HERE
-----END PRIVATE KEY-----"

# ── iOS Code signing ─────────────────────────────────────────────────────────
TEAM_ID="YOUR_TEAM_ID"
BUNDLE_ID="com.example.yourapp"
CODE_SIGN_IDENTITY="Apple Distribution"
PROVISIONING_PROFILE_NAME="YourAppStoreProfile"

# ── iOS Certificate paths (relative to project root) ─────────────────────────
APP_DIST=".app_dist"
P12_FILE=".app_dist/your_cert.p12"
P12_PASSWORD="your_p12_password"
PROFILE_FILE=".app_dist/YourAppStore.mobileprovision"
WWDR_CERT=".app_dist/AppleWWDRCAG3.cer"

# ── Android signing (keystore in .app_dist) ──────────────────────────────────
ANDROID_KEYSTORE_FILE=".app_dist/your_keystore.jks"
ANDROID_KEYSTORE_PASSWORD="your_keystore_password"
ANDROID_KEY_ALIAS="your_key_alias"
ANDROID_KEY_PASSWORD="your_key_password"

# ── Firebase App Distribution ────────────────────────────────────────────────
# Get token: firebase login:ci
FIREBASE_APP_ID="1:XXXXXXXXXXXX:android:XXXXXXXXXXXXXXXXXXXXXXXX"
FIREBASE_TOKEN=""
FIREBASE_GROUPS="developer"

# ── Keychain ────────────────────────────────────────────────────────────────
TEMP_KEYCHAIN_NAME="build.keychain"
TEMP_KEYCHAIN_PASS="tempbuild123"
KEYCHAIN_UNLOCK_PASS="your_mac_login_password"

# ── Build output paths ───────────────────────────────────────────────────────
ARCHIVE_DIR="build/ios/archive"
EXPORT_DIR="build/ios/ipa"
ANDROID_APK_DIR="build/app/outputs/flutter-apk"

# ── Provisioning profile destination ─────────────────────────────────────────
PROFILE_DEST="$HOME/Library/MobileDevice/Provisioning Profiles"

# ── Telegram Build Notifications ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_DISABLE_NOTIFICATION="false"
