# ============================================================================
# .env.prod — store-release credentials (DUMMY VALUES — replace, never commit)
# Copy to project root as .env.prod and add .env.prod to .gitignore.
# ============================================================================

# ---- iOS / App Store Connect ------------------------------------------------
BUNDLE_ID=com.example.myapp
APP_NAME=My App
TEAM_ID=XXXXXXXXXX
APP_VERSION=1.0.0
APP_SKU=my-app-sku

# App Store Connect API key (Users and Access -> Integrations)
APPLE_API_KEY_ID=XXXXXXXXXX
ISSUER_ID=00000000-0000-0000-0000-000000000000
# Either point at the .p8 file, or inline the key contents (BEGIN/END lines).
# Fastfile reads ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8 — prod.sh maps these.
APPLE_API_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nDUMMYKEYDUMMYKEYDUMMYKEYDUMMYKEY\n-----END PRIVATE KEY-----"

# Optional manual-signing assets for CI (otherwise use Xcode automatic signing)
P12_FILE=.app_dist/dummy_distribution.p12
P12_PASSWORD=dummy-p12-password
PROFILE_FILE=.app_dist/DummyAppStore.mobileprovision
WWDR_CERT=.app_dist/AppleWWDRCAG3.cer

# ---- Android / Google Play --------------------------------------------------
PLAYSTORE_PACKAGE_NAME=com.example.myapp
PLAYSTORE_TRACK=internal
PLAYSTORE_SERVICE_ACCOUNT_JSON=.app_dist/play-store-service-account.json

ANDROID_KEYSTORE_FILE=.app_dist/dummy-release.jks
ANDROID_KEYSTORE_PASSWORD=dummy-keystore-password
ANDROID_KEY_ALIAS=dummy-key-alias
ANDROID_KEY_PASSWORD=dummy-key-password

# ---- Optional: Firebase App Distribution (internal iOS/Android) --------------
FIREBASE_APP_ID=1:000000000000:android:0000000000000000
FIREBASE_TOKEN=dummy-firebase-ci-token
FIREBASE_GROUPS=testers

# ---- Optional: Telegram build notifications ---------------------------------
TELEGRAM_BOT_TOKEN=0000000000:DUMMY-telegram-bot-token
TELEGRAM_CHAT_ID=-1000000000000
